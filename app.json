{
  "expo": {
    "name": "Location Log",
    "slug": "location-log",
    "version": "0.1.1",
    "orientation": "portrait",
    "scheme": "locationlog",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.locationlog.app",
      "infoPlist": {
        "UIFileSharingEnabled": false,
        "LSSupportsOpeningDocumentsInPlace": false
      }
    },
    "android": {
      "package": "org.locationlog.app",
      "allowBackup": false,
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/location-journal-icon.png",
        "backgroundColor": "#173F35"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true,
          "enableFTS": false
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Location Log records your location while the app is closed to maintain your private location journal.",
          "locationWhenInUsePermission": "Location Log records your coordinates and reported accuracy on this device."
        }
      ],
      "expo-sharing",
      "expo-font"
    ],
    "web": {
      "bundler": "metro",
      "favicon": "./assets/location-journal-icon.png"
    },
    "icon": "./assets/location-journal-icon.png"
  }
}
